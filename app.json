{
  "expo": {
    "name": "Yulo Stores",
    "slug": "yulo-stores",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yulostores",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d9035e4f-187c-404b-a188-1d47e7390c84"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yulostores.customerapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yulo Stores uses your location to show stores that deliver to you and to place your delivery pin accurately."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0533",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yulostores.customerapp",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-navigation-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF5A00"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yulo Stores uses your location to show stores that deliver to you and to place your delivery pin accurately."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yulo Stores accesses your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yulo Stores uses the camera to scan store and table QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiPort": 3000,
      "apiUrl": null,
      "sentryDsn": null,
      "eas": {
        "projectId": "d9035e4f-187c-404b-a188-1d47e7390c84"
      }
    },
    "owner": "vescavias-team"
  }
}
